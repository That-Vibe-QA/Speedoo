# Speedoo Environment Configuration
# Copy this file to .env and adjust variables as needed

FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# Secret key used for session signing and CSRF protection
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database URI (Defaults to local SQLite speedoo.db)
# For PostgreSQL: postgresql://username:password@localhost:5432/speedoodb
DATABASE_URL=sqlite:///speedoo.db

# Server port and host
PORT=5000
HOST=127.0.0.1

